{
  "name": "office-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/build-wps-entries.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:office": "vite --mode office --host localhost",
    "build": "node scripts/build-wps-entries.mjs && tsc --noEmit && vite build",
    "setup:office": "node scripts/office-dev.mjs install",
    "remove:office": "node scripts/office-dev.mjs remove",
    "validate:office": "office-addin-manifest validate manifests/office/manifest.xml",
    "setup:wps": "node scripts/build-wps-entries.mjs && powershell.exe -NoProfile -File scripts/register-wps.ps1 -Action Install",
    "remove:wps": "powershell.exe -NoProfile -File scripts/register-wps.ps1 -Action Remove",
    "prepare:native": "node scripts/prepare-native-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/office-js": "^1.0.500",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-dev-settings": "^4.0.1",
    "office-addin-manifest": "^3.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
